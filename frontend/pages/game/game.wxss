.game-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
}

/* 信息面板 */
.info-panel {
  display: flex;
  justify-content: space-around;
  width: 100%;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(255, 158, 197, 0.2);
}

.info-item {
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #FF9EC5;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6BA3;
}

/* 游戏主区域 */
.game-main {
  display: flex;
  gap: 20rpx;
}

/* 下一个方块预览 */
.next-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(255, 158, 197, 0.2);
}

.preview-title {
  font-size: 24rpx;
  color: #FF9EC5;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.preview-box {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.preview-row {
  display: flex;
  gap: 4rpx;
}

.preview-cell {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: #FFF5F8;
}

/* 游戏板 */
.game-board {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 10rpx;
  border-radius: 15rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.3);
}

.board-row {
  display: flex;
  gap: 2rpx;
}

.board-cell {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.board-cell[style*="background"] {
  box-shadow: inset 0 0 10rpx rgba(255, 255, 255, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

/* 控制按钮 */
.control-buttons {
  margin-top: 30rpx;
}

.start-btn {
  font-size: 36rpx;
  padding: 30rpx 80rpx;
}

/* 控制面板 */
.control-panel {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.control-row {
  display: flex;
  gap: 20rpx;
}

.control-btn {
  background: linear-gradient(135deg, #FF9EC5 0%, #FF6BA3 100%);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 163, 0.4);
  margin: 0;
}

.control-btn:active {
  transform: scale(0.95);
}

/* 游戏结束 */
.game-over-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.game-over-content {
  background: linear-gradient(135deg, #FFF5F8 0%, #FFE4F0 100%);
  border-radius: 40rpx;
  padding: 60rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(255, 107, 163, 0.3);
  border: 4rpx solid #FF9EC5;
}

.game-over-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF6BA3;
  margin-bottom: 30rpx;
}

.game-over-score {
  font-size: 40rpx;
  color: #FF9EC5;
  margin-bottom: 40rpx;
}

.input-section {
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #FF6BA3;
  margin-bottom: 20rpx;
}

.name-input {
  background: white;
  border-radius: 30rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border: 3rpx solid #FF9EC5;
  margin-bottom: 20rpx;
}

.submit-btn, .restart-btn, .back-btn {
  margin: 15rpx 0;
  width: 100%;
}
